{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {
		"explorer.autoRevealExclude": {
			".mypy_cache": true,
			"venv": true,
			".venv*": true,
			".venv": true,
			"**/._.DS_Store": true,
			"**/__pycache__": true,
			"bazel-bin": true,
			"bazel-datadog": true,
			"bazel-out": true,
			"bazel-testlogs": true,
			"bazel-python-gen-tries": true,
			"coverage.lcov": true
		},
		"terminal.integrated.env.linux": {
			"PYTHONPATH": "${workspaceFolder}/src:${workspaceFolder}/tests"
		},
		"terminal.integrated.env.osx": {
			"PYTHONPATH": "${workspaceFolder}/src:${workspaceFolder}/tests"
		},
		"terminal.integrated.env.windows": {
			"PYTHONPATH": "${workspaceFolder}\\src;${workspaceFolder}\\tests"
		},
		"testing.coverageToolbarEnabled": true,
		"coverage-gutters.coverageReportFileName": "coverage_html_report/index.html",
		"coverage-gutters.showLineCoverage": true,
		"coverage-gutters.watchOnActivate": true,
		"coverage-gutters.showGutterCoverage": true,
		"testing.showCoverageInExplorer": false,
		"coverage-gutters.showRulerCoverage": true,
		"coverage-gutters.coverageFileNames": ["coverage.xml"]
	}
}