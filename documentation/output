ses remain consistent throughout their lifecycle.', '', 'The results of the benchmark runs are stored in the `results` property, which is a list', 'of Results objects. Each Results object corresponds to a specific combination of', 'keyword argument variations.', '', '.. code-block:: python3', '  :caption: Minimal Example', '', '    from simplebench import (', '        Case, SimpleRunner, Results, main)', '', '', '    def my_benchmark_action(bench: SimpleRunner,', '                            **kwargs) -> Results:', '        # Perform benchmark action here', '        def benchmark_operation():', '            sum(range(1000))  # Example operation to benchmark', '', '        return bench.run(benchmark_operation)', '', '', "    if __name__ == '__main__':", '        cases_list: list[Case] = [', '            Case(action=my_benchmark_action)', '        ]', '        main(cases_list)', '', '', ''])
